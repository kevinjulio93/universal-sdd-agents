# ==============================================================================
# UNIVERSAL SDD AGENTS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copia este archivo a `.env` y completa los valores con tus credenciales reales.
# NUNCA agregues ni subas el archivo `.env` a Git.

# ------------------------------------------------------------------------------
# 1. MCP Remote Servers (APIs y Servicios Remotos)
# ------------------------------------------------------------------------------
# Context7 MCP (Resolución de librerías y documentación en tiempo real)
CONTEXT7_MCP_URL=https://mcp.context7.com/mcp

# n8n MCP Server (Orquestación de workflows)
N8N_MCP_URL=https://n8nworkflow.juliomarquez.dev/mcp-server/http
N8N_MCP_TOKEN=your_n8n_bearer_token_here

# Google Drive MCP Server
GOOGLE_DRIVE_MCP_URL=https://drivemcp.googleapis.com/mcp/v1

# Canva MCP Server
CANVA_MCP_URL=https://mcp.canva.com/mcp

# ------------------------------------------------------------------------------
# 2. Local Binaries (Rutas de ejecutables locales en tu máquina)
# ------------------------------------------------------------------------------
# Por defecto se resuelven contra el PATH del sistema.
# Puedes sobreescribir la ruta absoluta si utilizas un entorno específico.
UVX_BIN=uvx
NPX_BIN=npx
PYTHON_BIN=python3
NODE_BIN=node

# ------------------------------------------------------------------------------
# 3. Deterministic Gate Tooling
# ------------------------------------------------------------------------------
# Umbrales mínimos de Quality Gates
MIN_TEST_COVERAGE=80
MAX_ALLOWED_SAST_SEVERITY=HIGH
SCHEMATHESIS_MAX_EXAMPLES=50
